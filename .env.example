# Category suggestions fall back to a deterministic, offline lexical matcher
# when AI_API_KEY is unset, so none of these are required to run the app.

# AI_API_KEY=sk-...
# Any OpenAI-compatible endpoint (Ollama, vLLM, Together, OpenAI itself).
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
